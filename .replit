modules = ["php-8.2"]

[nix]
channel = "stable-24_05"

[deployment]
run = ["bash", "start.sh"]
deploymentTarget = "autoscale"
build = ["composer", "install", "--no-dev", "--optimize-autoloader", "--ignore-platform-req=ext-mongodb"]

[[ports]]
localPort = 5000
externalPort = 80

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash start.sh"
waitForPort = 5000
